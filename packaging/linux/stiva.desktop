[Desktop Entry]
Type=Application
Name=Stiva
GenericName=Video converter
Comment=Convert video with ffmpeg, with a queue and presets
Exec=stiva %F
Icon=stiva
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
